	/**
	 * @param string $_eqType_name
	 * @param bool $_onlyEnable
	 * @return static[]
	 */
	public static function byType($_eqType_name, $_onlyEnable = false) {}

	/**
	 * @param string|null $_type
	 * @param string|null $_logicalId
	 * @param mixed $_visible
	 * @param bool $_multiple
	 * @return ($_logicalId is null ? cmd[] : ($_multiple is true ? cmd[] : cmd|false))
	 */
	public function getCmd($_type = null, $_logicalId = null, $_visible = null, $_multiple = false) {}

	/**
	 * @return int|string
	 */
	public function getId() {}

	/**
	 * @return string
	 */
	public function getName() {}

	/**
	 * @param bool $_tag
	 * @param bool $_prettify
	 * @return string
	 */
	public function getHumanName($_tag = false, $_prettify = false) {}
}

